# Copy to .env (git-ignored) and fill with approved TEST values only.
# Never put production hosts, real customer data, or shared credentials here.

# --- Target environment -----------------------------------------------------
# Approved staging only. Approved hosts are fixed in config/environments.ts;
# this value selects the target and cannot widen the allowlist.
# Production (https://my.internetticketing.com) is always blocked.
CLOUD_SIGNUP_BASE_URL=https://it.taposapp.com
# Extra regex patterns for production hosts (adds to config/blocked-hosts.ts).
QA_BLOCKED_HOST_PATTERNS=
# TC-A03 only: a staging host configured with the signup feature gate OFF (must be approved in config/environments.ts).
CLOUD_SIGNUP_GATE_OFF_BASE_URL=

# --- Run context ------------------------------------------------------------
# Set to "nightly" in the scheduled pipeline: only framework and A-readonly may run.
QA_RUN_CONTEXT=

# --- Suite A gated opt-ins (never set in nightly) ----------------------------
QA_ALLOW_AUTH_SESSION=
QA_ALLOW_SIGNUP_WRITES=
QA_ALLOW_RATE_LIMIT=

# --- Test accounts and inboxes (TEST only) ----------------------------------
QA_TEST_INBOX_ADDRESS=
QA_TEST_INBOX_ALLOWED_DOMAINS=
QA_TEST_INBOX_ADAPTER=
QA_EXISTING_USER_EMAIL=
QA_EXISTING_USER_PASSWORD=
QA_SIGNUP_ALERT_INBOX=
QA_SIGNUP_STATE_ADAPTER=

# --- Database targets (verified non-production before any E2E run) ---------
# Connection URLs; hosts must be listed in APPROVED_STAGING_DATABASE_HOSTS.
QA_WEBSALES_DB_URL=
QA_MEMBERSHIP_DB_URL=
QA_POS_DB_URL=

# --- Suite B hard gate (one approved staging database) -----------------------
QA_ALLOW_PROVISIONING=
QA_SUITE_B_APPROVAL_ID=
QA_SUITE_B_APPROVED_BY=
QA_SUITE_B_MAX_NEW_DATABASES=
QA_PRECHECK_STAGING_VERIFIED=
QA_PRECHECK_DISK_SPACE=
QA_PRECHECK_WORKER_RUNNING=
QA_PRECHECK_CLODEM_TEMPLATE_APPROVED=
QA_PRECHECK_TEST_INBOX=
QA_PRECHECK_REDIRECT_CONFIRMED=

# --- Suite C hard gate (isolated environment only) ---------------------------
QA_ALLOW_DESTRUCTIVE=
QA_SUITE_C_APPROVAL_ID=
QA_ISOLATED_ENVIRONMENT_CONFIRMED=
QA_ISOLATED_HOSTS=
QA_SHARED_STAGING_HOSTS=
